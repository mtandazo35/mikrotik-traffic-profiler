[Unit]
Description=Perfil diario de trafico por categoria (ventana 7 dias, retencion 14)
After=network-online.target

[Service]
Type=oneshot
User=mtp
Group=mtp
WorkingDirectory=/opt/mikrotik-traffic-profiler
Environment=TZ=America/Guayaquil PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/mikrotik-traffic-profiler/mtp.env
ExecCondition=/bin/sh -c 'ls /var/lib/mikrotik-traffic-profiler/data/crudo/*/*/muestras.jsonl >/dev/null 2>&1'
ExecStartPre=-/usr/bin/python3 trafico.py --datos /var/lib/mikrotik-traffic-profiler/data asn
ExecStart=/usr/bin/python3 trafico.py --datos /var/lib/mikrotik-traffic-profiler/data analizar --ip2asn /var/lib/mikrotik-traffic-profiler/data/ip2asn-v4.tsv.gz --dias 7
ExecStartPost=/usr/bin/python3 trafico.py --datos /var/lib/mikrotik-traffic-profiler/data limpiar --dias 14
TimeoutStartSec=1h
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/var/lib/mikrotik-traffic-profiler
