[Unit]
Description=Muestras de conntrack del router %i (solo lectura)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=mtp
Group=mtp
WorkingDirectory=/opt/mikrotik-traffic-profiler
Environment=TZ=America/Guayaquil PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/mikrotik-traffic-profiler/mtp.env
ExecStart=/usr/bin/python3 trafico.py --inventario /etc/mikrotik-traffic-profiler/inventario.json --datos /var/lib/mikrotik-traffic-profiler/data recolectar --router %i --categoria ${CATEGORIA} --repetir ${REPETIR} --intervalo ${INTERVALO}
TimeoutStartSec=2h
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/var/lib/mikrotik-traffic-profiler
