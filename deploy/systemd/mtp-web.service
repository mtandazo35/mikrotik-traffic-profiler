[Unit]
Description=Panel web del perfilador de trafico MikroTik
After=network-online.target
Wants=network-online.target

[Service]
User=mtp
Group=mtp
WorkingDirectory=/opt/mikrotik-traffic-profiler
Environment=TZ=America/Guayaquil PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/mikrotik-traffic-profiler/mtp.env
ExecStart=/usr/bin/python3 -m mtp.web --config /etc/mikrotik-traffic-profiler/web.json --inventario /var/lib/mikrotik-traffic-profiler/inventario.json --datos /var/lib/mikrotik-traffic-profiler/data --llave-publica /var/lib/mikrotik-traffic-profiler/.ssh/id_rsa.pub --puerto ${PUERTO_WEB}
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/var/lib/mikrotik-traffic-profiler

[Install]
WantedBy=multi-user.target
